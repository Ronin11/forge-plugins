[namecheap]
api_user  = "your-namecheap-username"
api_key   = "from Profile > Tools > API Access"
username  = "your-namecheap-username"
client_ip = "this machine's public IPv4 (must be whitelisted in API Access)"
# The registration gate: both must pass, on top of the approved question.
max_usd_per_purchase = 20.0
allowed_tlds = ["com", "dev", "io", "net", "org", "app"]
